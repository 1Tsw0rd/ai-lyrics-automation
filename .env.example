CLAUDE_API_KEY=

# Opus
# CLAUDE_GENERATE_MODEL=claude-opus-5
# CLAUDE_REVIEW_MODEL=claude-opus-5

# Sonnet
CLAUDE_GENERATE_MODEL=claude-sonnet-5
CLAUDE_REVIEW_MODEL=claude-sonnet-5

# Haiku
# CLAUDE_GENERATE_MODEL=claude-haiku-5
# CLAUDE_REVIEW_MODEL=claude-haiku-5

# Debug mode
DEBUG_MODE=true                  # Claude API 요청/응답의 상세 내용을 콘솔과 로그 파일에 기록

# Album processing range
START_ALBUM=7                    # 처리를 시작할 앨범 번호
END_ALBUM=0                      # 처리를 종료할 앨범 번호 (0이면 마지막 앨범까지 처리)

# Lyrics generation and review
MAX_ROUNDS=10                    # 가사 생성 및 검토를 반복하는 최대 횟수

# API request interval
SLEEP_LYRICS_MS=6000             # 가사 생성 및 검토 API 호출 사이의 대기 시간(ms)
SLEEP_TRANSLATE_MS=6000          # 번역 API 호출 전 대기 시간(ms)
