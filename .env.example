CLAUDE_API_KEY=

# Claude thinking 사용 여부
# true: 활성화 / false: 비활성화
ENABLE_THINKING=false

# Claude 모델
# ──────────────────────────────────────

# 가사 생성
# CLAUDE_GENERATE_MODEL=claude-opus-5
CLAUDE_GENERATE_MODEL=claude-sonnet-5
# CLAUDE_GENERATE_MODEL=claude-haiku-4-5-20251001

# 가사 검토
# CLAUDE_REVIEW_MODEL=claude-opus-5
CLAUDE_REVIEW_MODEL=claude-sonnet-5
# CLAUDE_REVIEW_MODEL=claude-haiku-4-5-20251001

# 한국어 번역
CLAUDE_TRANSLATE_MODEL=claude-sonnet-5

# 디버그 로그
# true: Claude API 요청/응답 상세 내용 기록
# false: 기본 로그만 기록
DEBUG_MODE=true

# 앨범 처리 범위
# START_ALBUM: 시작 앨범 번호
# END_ALBUM: 종료 앨범 번호 (0이면 마지막 앨범까지)
START_ALBUM=7
END_ALBUM=0

# 가사 생성 / 검토
# 최대 반복 횟수
MAX_ROUNDS=10

# API 요청 간 대기 시간(ms)
SLEEP_LYRICS_MS=6000
SLEEP_TRANSLATE_MS=6000